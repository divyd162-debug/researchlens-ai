# ResearchLens AI - Root Environment Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
ENVIRONMENT=development
APP_NAME="ResearchLens AI"
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchlens

# LLM Provider Configuration
# Supported options: mock (default offline deterministic), omniroute (production OpenAI-compatible gateway)
LLM_PROVIDER=mock

# OmniRoute Production LLM Gateway Configuration
# Required when LLM_PROVIDER=omniroute:
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=your_omniroute_api_key_here
# OMNIROUTE_MODEL=gemini-fallback-combo
# OMNIROUTE_TIMEOUT_SECONDS=60.0
# OMNIROUTE_MAX_RETRIES=1

# JWT Authentication Configuration (Phase 5, Milestone 1A)
# Required in production: must be a strong random secret of at least 32 characters.
# In development/test, a fallback default is provided if omitted.
JWT_SECRET_KEY=dev-insecure-jwt-secret-do-not-use-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
